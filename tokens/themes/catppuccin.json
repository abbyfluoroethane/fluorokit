{
  "name": "catppuccin",
  "description": "Modified Catppuccin Mocha and Latte with a pink accent. From the personal site, design system 1.1.",
  "default": "mocha",
  "followSystem": true,
  "print": "paper",
  "fonts": {
    "font-sans": "\"IBM Plex Sans\", system-ui, sans-serif",
    "font-serif": "\"IBM Plex Serif\", Georgia, serif",
    "font-mono": "\"IBM Plex Mono\", ui-monospace, monospace"
