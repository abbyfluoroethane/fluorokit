{
  "name": "fluorokit",
  "version": "0.2.0",
  "description": "A Metro theme for shadcn-svelte: tokens, themes and base CSS, plus tiles, a pivot and a theme CLI.",
  "keywords": [
    "shadcn-svelte",
    "shadcn",
    "svelte",
    "theme",
    "metro",
    "windows-phone",
    "tailwindcss",
    "design-tokens",
    "css"
  ],
  "license": "MIT",
  "author": "Abby Bigaouette",
  "homepage": "https://fluorokit.bigaouette.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abbyfluoroethane/fluorokit.git"
  },
  "type": "module",
  "files": [
    "bin",
    "dist",
    "tokens",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./structure.css": "./dist/structure.css",
    "./base.css": "./dist/base.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./themes/*": "./dist/themes/*",
    "./themes.json": "./dist/themes.json",
    "./fonts/*": "./dist/fonts/*",
    "./tools/*": "./dist/tools/*",
    "./shiki/*": "./dist/shiki/*",
    "./enter": {
      "types": "./dist/enter.d.ts",
      "default": "./dist/enter.js"
    },
    "./svelte/*": {
      "svelte": "./dist/svelte/*",
      "default": "./dist/svelte/*"
    },
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "bin": {
    "fluorokit": "bin/fluorokit.mjs"
  }
}
